ASPNETCORE_ENVIRONMENT=Development
SSO_SQLSERVER_PASSWORD=replace-with-local-development-password
SSO_REDIS_PASSWORD=replace-with-local-development-password
SSO_SIGNING_CERTIFICATE_PATH=/run/secrets/signing-certificate.pfx
SSO_SIGNING_CERTIFICATE_PASSWORD=replace-with-secret-manager-value
SSO_ADMIN_BOOTSTRAP_EMAIL=admin@example.test
SSO_ADMIN_BOOTSTRAP_PASSWORD=replace-with-user-secrets-value
